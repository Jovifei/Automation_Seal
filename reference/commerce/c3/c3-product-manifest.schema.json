{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovi.local/schema/c3-product-manifest-v1.json",
  "title": "C3 Real SKU Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "name",
    "version",
    "owner",
    "rights_status",
    "prohibited_content_confirmed_absent",
    "source_git_head",
    "supported_platforms",
    "deliverables",
    "acceptance_criteria",
    "third_party_dependencies",
    "support_boundary",
    "known_limitations",
    "product_source_readonly",
    "candidate_only"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"const": "E01"},
    "name": {"const": "Modbus RTU Diagnostic Toolkit"},
    "version": {"type": "string", "minLength": 1},
    "owner": {"const": "Jovi"},
    "rights_status": {"enum": ["original", "original_plus_licensed_dependencies"]},
    "prohibited_content_confirmed_absent": {"const": true},
    "source_git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "evidence_ref"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "VERIFIED"},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "relative_path", "sha256", "size_bytes"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status", "evidence_ref"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "third_party_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "license", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "support_boundary": {"type": "string", "minLength": 1},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "product_source_readonly": {"const": true},
    "candidate_only": {"const": true}
  }
}
