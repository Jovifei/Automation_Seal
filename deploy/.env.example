# bootstrap.ps1 copies this to .env and generates strong secrets.
COMPOSE_PROJECT_NAME=jovi-automation
TZ=Asia/Shanghai

# Candidate versions. Codex must verify and pin Tag/Digest before production.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=jovi_automation
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jovi_automation

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.29.10
N8N_PORT=5678
N8N_ENCRYPTION_KEY=CHANGE_ME

CHANGEDETECTION_IMAGE=dgtlmoon/changedetection.io:0.55.7
CHANGEDETECTION_PORT=5000

REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=CHANGE_ME

# No AI credential is stored here by default.
AI_PROVIDER=
AI_API_KEY=
